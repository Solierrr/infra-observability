    {
      "type": "row",
      "title": "Erros por rota",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "table",
      "title": "Erros por serviço, rota e status",
      "description": "Respostas 4xx e 5xx por serviço, rota e status no intervalo. Mostra também 401 de rota inexistente, que os serviços respondem antes de achar a rota.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round((sum by (service_name, route, status) (label_replace(sum by (service_name,uri,status) (increase(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"[45]..\"}[$__range])), \"route\", \"$1\", \"uri\", \"(.*)\")) or sum by (service_name, route, status) (label_replace(label_replace(sum by (service_name,http_target,http_status_code) (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"[45]..\"}[$__range])), \"route\", \"$1\", \"http_target\", \"(.*)\"), \"status\", \"$1\", \"http_status_code\", \"(.*)\"))) > 0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Respostas",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
