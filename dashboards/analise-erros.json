      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Respostas 4xx e 5xx por status",
      "description": "Respostas 4xx e 5xx por segundo, por código de status, de todos os serviços.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (status) (sum by (status) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"[45]..\"}[$__rate_interval])) or label_replace(sum by (http_status_code) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"[45]..\"}[$__rate_interval])), \"status\", \"$1\", \"http_status_code\", \"(.*)\"))",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Sem dados",
          "color": {
