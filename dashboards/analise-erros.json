{
  "uid": "solier-analise-erros",
  "title": "SOLIER — Análise de erros",
  "description": "O que está quebrando, onde e desde quando, em todos os serviços, inclusive erros que não aparecem como 5xx.",
  "id": null,
  "tags": [
    "solier"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Saúde geral",
      "url": "/d/solier-saude-geral?${environment:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    },
    {
      "type": "link",
      "title": "Serviço Java",
      "url": "/d/solier-servico-java?${environment:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    },
    {
      "type": "link",
      "title": "Serviço Python",
      "url": "/d/solier-servico-python?${environment:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "tags": []
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Visão do erro",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Erros 5xx no período",
      "description": "Respostas 5xx somadas de todos os serviços no intervalo selecionado.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(((sum (increase(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"5..\"}[$__range]))) or vector(0)) + ((sum (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"5..\"}[$__range]))) or vector(0)))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Taxa de erros 5xx",
      "description": "Percentual de respostas 5xx sobre o total. Amarelo a partir de 1 %, vermelho a partir de 5 %.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (((sum (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"5..\"}[$__rate_interval]))) or vector(0)) + ((sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"5..\"}[$__rate_interval]))) or vector(0))) / (((sum (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval]))) or vector(0)) + ((sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval]))) or vector(0))) and on() ((((sum (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval]))) or vector(0)) + ((sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval]))) or vector(0))) > 0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Serviços com erro",
      "description": "Serviços com taxa de erro 5xx de 1 % ou mais agora.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(((100 * (sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval]))) / (sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval])) > 0)) or (100 * (sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval]))) / (sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval])) > 0))) >= 1) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Erros de negócio nos logs",
      "description": "Linhas de log com PROVIDER_UNAVAILABLE (IA sem provedor) ou CORE_PROVISIONING_DLQ (usuário não provisionado) no intervalo. São falhas que a resposta HTTP não mostra.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({deployment_environment=\"$environment\"} |~ \"PROVIDER_UNAVAILABLE|CORE_PROVISIONING_DLQ\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Quando e onde",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Taxa de erros 5xx por serviço",
      "description": "Taxa de erro 5xx por serviço. As linhas marcam 1 % e 5 %.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((100 * (sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\",status=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval]))) / (sum by (service_name) (rate(http_server_requests_milliseconds_count{deployment_environment=\"$environment\",uri!~\"/actuator.*\",service_name=~\"auth|core|messager|api-notify\"}[$__rate_interval])) > 0)) or (100 * (sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\",http_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval]))) / (sum by (service_name) (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=~\"google-registry|api-recommendation|ai-accessibility|ai-validation\"}[$__rate_interval])) > 0)))",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
