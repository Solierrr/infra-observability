    {
      "type": "timeseries",
      "title": "Requisições por classe de status",
      "description": "Requisições por segundo por classe de status. 2xx deu certo, 4xx erro do cliente, 5xx erro do serviço.",
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 7,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\",http_status_code=~\"2..\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "2xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\",http_status_code=~\"4..\"}[$__rate_interval])) or 0 * sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__rate_interval])))",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "4xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\",http_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__rate_interval])))",
          "refId": "C",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
