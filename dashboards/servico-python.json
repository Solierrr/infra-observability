    {
      "type": "stat",
      "title": "Requisições por segundo",
      "description": "Requisições por segundo do serviço, sem health checks.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health|\",service_name=\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Taxa de erros 5xx",
      "description": "Percentual de respostas 5xx. Amarelo a partir de 1 %, vermelho a partir de 5 %.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(100 * (sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\",http_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__rate_interval]))) / (sum (rate(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__rate_interval])) > 0))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Latência p95",
      "description": "Latência p95 das respostas 2xx e 3xx: 95 % das requisições são mais rápidas que isto. Amarelo a partir de 500 ms, vermelho a partir de 2000 ms.",
      "gridPos": {
        "x": 12,
        "y": 1,
