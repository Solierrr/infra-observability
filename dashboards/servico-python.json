                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 2000
              }
            ]
          },
          "noValue": "Sem dados",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
