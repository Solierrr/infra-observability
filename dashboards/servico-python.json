    {
      "type": "table",
      "title": "Erros e latência por rota",
      "description": "Por rota e método no intervalo selecionado. Ordenada por taxa de erro 5xx; as colunas coloridas seguem os mesmos limites dos números do topo.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum by (http_target,http_method) (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__range])))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((100 * (sum by (http_target,http_method) (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\",http_status_code=~\"5..\"}[$__range])) or 0 * sum by (http_target,http_method) (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__range]))) / (sum by (http_target,http_method) (increase(http_server_duration_milliseconds_count{deployment_environment=\"$environment\",http_target!~\"/health\",service_name=\"$service\"}[$__range])) > 0)))",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (http_target,http_method,le) (increase(http_server_duration_milliseconds_bucket{deployment_environment=\"$environment\",http_target!~\"/health|\",service_name=\"$service\",http_status_code=~\"2..|3..\"}[$__range])))",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Erro 5xx (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
